# Optional: an OpenAI-compatible endpoint for repository analysis and the standalone chat UI (`npm start`).
# Without it, the agent draws from the evidence itself (DRAWMAN_SAMPLING=1 opts in to the host model).
DRAWMAN_LLM_URL=https://api.openai.com/v1
DRAWMAN_LLM_KEY=
DRAWMAN_LLM_MODEL=gpt-4.1
# Header that carries the key; "Authorization" sends "Bearer <key>" (gateways may use e.g. x-api-key)
DRAWMAN_LLM_KEY_HEADER=Authorization

# Folders the server may read (separated by ; on Windows, : elsewhere). Default: current directory.
# DRAWMAN_WORKSPACE_ROOTS=
# Host for owner/repo shorthands, e.g. a GitHub Enterprise Server
# DRAWMAN_GITHUB_HOST=github.com
# Organisation profile (conventions, vocabulary hints, internal endpoints), see examples/profile.example.json
# DRAWMAN_PROFILE=
# Set to 0 to only allow folders of the workspace (no remote clones)
# DRAWMAN_ALLOW_CLONE=1
# Some corporate networks stall on IPv6: prefer IPv4
# DRAWMAN_IPV4_FIRST=1
# auto: save .drawio files only for hosts without the live view; always; never
# DRAWMAN_SAVE=auto
