{
  "name": "drawman",
  "version": "0.2.0",
  "description": "draw.io on steroids. Much cheaper, extremely fast, high-quality draw.io diagrams for AI coding agents: architecture, flowcharts, sequence, state, UML class and ER diagrams, plus repository analysis. MCP server + MCP App.",
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "drawio",
    "diagrams.net",
    "architecture-diagram",
    "flowchart",
    "sequence-diagram",
    "uml",
    "er-diagram",
    "gcp",
    "azure",
    "sap-btp",
    "copilot",
    "claude",
    "cursor",
    "windsurf"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamalali/drawman.git"
  },
  "homepage": "https://github.com/zamalali/drawman#readme",
  "bugs": {
    "url": "https://github.com/zamalali/drawman/issues"
  },
  "type": "module",
  "bin": {
    "drawman": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/view",
    "dist/web",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "icons": "tsx scripts/build-icons.ts",
    "build": "tsx scripts/build-icons.ts --if-missing && vite build -c vite.view.config.ts && vite build -c vite.web.config.ts && tsx scripts/bundle.ts",
    "build:view": "vite build -c vite.view.config.ts",
    "build:vscode": "npm run build && tsx scripts/bundle.ts --vscode && npm --prefix vscode run package",
    "start": "tsx src/cli.ts web",
    "mcp": "tsx src/cli.ts mcp",
    "serve": "tsx src/cli.ts serve",
    "pretest": "tsx scripts/build-icons.ts --if-missing",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elkjs": "0.10.0",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
